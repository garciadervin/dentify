# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-web/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# RAG generated export (regenerate with: npm run ingest:rag -- --dry-run)
docs/rag-export.json

# Playwright captures and console logs
.playwright-cli/
dentify-*.png
e2e/artifacts/
test-results/

# CodeGraph local index
.codegraph/

# Backup of original GLB models (regenerate with: npm run optimize:models -- --restore)
assets/models/.originals/

# Clinical textbook PDFs (copyrighted — do not publish; re-ingest from a local copy)
docs/*.pdf

# Private notes (do not publish)
docs/dentify.txt
