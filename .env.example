# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RAG ingestion (scripts/ingest-rag.mjs) — only needed when loading manuals
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# GEMINI_API_KEY=your_google_ai_studio_key

# Google AI Studio (for Denty-AI) — set as Supabase secret, NOT in .env
# Run: supabase secrets set GEMINI_API_KEY=your_gemini_api_key
# The key is only read server-side by the denty-agent / denty-transcribe Edge Functions.
