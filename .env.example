# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RAG ingestion (scripts/ingest-rag.mjs) — only needed when loading manuals
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# OPENAI_API_KEY=your_openai_api_key   # only for --embedder openai (1536-dim, semantic)

# Groq API (for Denty-AI) — set as Supabase secret, NOT in .env
# Run: supabase secrets set GROQ_API_KEY=your_groq_api_key
# EXPO_PUBLIC_GROQ_API_KEY is no longer used client-side
